# 데이터 원본·중간산출물은 커밋하지 않는다 (용량 + 배포 라이선스)
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
!data/**/SOURCE.txt

# 최종 타일만 예외 — GitHub Pages 배포에 필요
!web/data/
web/data/*.mbtiles

# 인증키
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/

# Node
node_modules/

# OS / 에디터
.DS_Store
.vscode/
.idea/

# 검증 도구 임시 산출물
tools/_*.mjs
web/_*.html
node_modules/
package-lock.json
